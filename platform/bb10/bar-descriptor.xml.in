<?xml version="1.0" encoding="utf-8" standalone="no"?>
<qnx xmlns="http://www.qnx.com/schemas/application/1.0">
    <id>org.koreader.bb10</id>
    <name>KOReader</name>
    <versionNumber>@VERSION@</versionNumber>
    <buildId>@BUILD_ID@</buildId>
    <description>KOReader document viewer (BlackBerry 10 port)</description>
    <author>KOReader BB10 port</author>
    <initialWindow>
        <autoOrients>false</autoOrients>
        <systemChrome>none</systemChrome>
    </initialWindow>
    <configuration name="Device-Release">
       <platformArchitecture>armle-v7</platformArchitecture>
       <asset path="koreader-launcher" entry="true" type="Qnx/Elf">koreader-launcher</asset>
    </configuration>
    <icon>
        <image>icon.png</image>
    </icon>
    <asset path="icon.png">icon.png</asset>
@ASSETS@
    <permission system="true">run_native</permission>
    <permission>access_shared</permission>
    <permission>access_internet</permission>
</qnx>
